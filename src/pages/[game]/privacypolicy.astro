---
import type {
  GetStaticPaths,
  ImageMetadata,
  InferGetStaticPropsType,
} from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { games } from "../../data/games";
import { SITE } from "../../data/site";
import "../../styles/games.css";

export const getStaticPaths = (() => {
  const faviconModules = import.meta.glob<{ default: ImageMetadata }>(
    "../../res/games/*/favicon.png",
    { eager: true },
  );
  const ogModules = import.meta.glob<{ default: ImageMetadata }>(
    "../../res/games/*/og.png",
    { eager: true },
  );
  const faviconByGameId: Record<string, ImageMetadata> = Object.fromEntries(
    Object.entries(faviconModules).map(([path, module]) => [
      path.split("/").at(-2),
      module.default,
    ]),
  );
  const ogByGameId: Record<string, ImageMetadata> = Object.fromEntries(
    Object.entries(ogModules).map(([path, module]) => [
      path.split("/").at(-2),
      module.default,
    ]),
  );

  return games.map((game) => ({
    params: { game: game.id },
    props: {
      game,
      favicon: faviconByGameId[game.id],
      og: ogByGameId[game.id],
    },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { game, favicon, og } = Astro.props;

const pageUrl = `${SITE.hostname}/${game.id}`;
const ogImage = new URL(og.src, Astro.site).href;
---

<BaseLayout
  title={`${game.name} - Privacy Policy`}
  description={`Privacy policy for ${game.name}: what data the game stores and how it is used.`}
  robots="noindex",
  og={{
    url: pageUrl,
    title: game.name,
    description: `Privacy policy for ${game.name}: what data the game stores and how it is used.`,
    image: ogImage,
    card: "summary_large_image",
  }}
>
  <Fragment slot="favicons">
    <link rel="icon" type="image/png" href={favicon.src} />
  </Fragment>
  <main class="content">
    <section class="container" aria-label="Privacy Policy">
      <h1>{game.name} - Privacy Policy</h1>
      <h2>User Info</h2>
      <p>No user info is collected by me.</p>
      <h2>Save Data</h2>
      <p>Save files are used to save settings and scores.</p>
      {
        game.useFirebase ? (
          <Fragment>
            <h2>Leaderboard</h2>
            <p>Google Firebase Database is used to store user scores.</p>
          </Fragment>
        ) : (
          <Fragment>
            <h2>Google Play Games</h2>
            <p>
              Google Play Games is used to store Achievements and Leaderboards.
            </p>
          </Fragment>
        )
      }
    </section>
  </main>
</BaseLayout>
