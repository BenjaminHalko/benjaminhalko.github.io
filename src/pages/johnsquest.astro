---
import { Font, Image } from "astro:assets";
import { YouTube } from "astro-embed";
import { Icon } from "astro-icon/components";
import JsonLd from "../components/JsonLd.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  johnsQuestDescription as DESCRIPTION,
  johnsQuestFeatures as features,
  johnsQuestGifs as gifs,
  johnsQuestTags as tags,
} from "../data/johnsquest-content";
import { SITE } from "../data/site";
import footer from "../res/johnsquest/footer.png";
import logo from "../res/johnsquest/logo.png";
import cover from "../res/johnsquest/cover.png";
import { johnsQuestSchema } from "../schema/johnsquest";
import "../styles/johnsquest.css";

const PAGE_URL = `${SITE.hostname}/johnsquest`;
const ogImage = new URL(cover.src, Astro.site).href;
---

<BaseLayout
  title="John's Quest - Press Kit"
  description={DESCRIPTION}
  og={{
    type: "website",
    url: PAGE_URL,
    title: "John's Quest",
    description: DESCRIPTION,
    image: ogImage,
    imageType: "image/png",
  }}
  twitter={{
    card: "summary_large_image",
    url: PAGE_URL,
    title: "John's Quest",
    description: DESCRIPTION,
    image: ogImage,
  }}
>
  <Fragment slot="favicons">
    <link
      rel="icon"
      type="image/png"
      href="/johnsquest/favicon-32x32.png"
      sizes="32x32"
    />
    <link rel="shortcut icon" href="/johnsquest/favicon.ico" />
  </Fragment>
  <Fragment slot="head">
    <Font cssVariable="--font-press-start-2p" preload />
    <JsonLd data={johnsQuestSchema} />
  </Fragment>

  <main>
    <Image
      src={logo}
      alt="John's Quest"
      class="logo"
      width={1072}
      height={468}
      loading="eager"
      fetchpriority="high"
    />

    <p class="tagline">
      You are <strong>John Appleby</strong>, game historian.
    </p>

    <section class="links">
      <a
        href="https://store.steampowered.com/app/4346950/Johns_Quest/"
        target="_blank"
        rel="noopener noreferrer"
        class="store-btn steam"
      >
        <Icon name="tabler:brand-steam" />
        Steam
      </a>
      <a
        href="https://benjamin-halko.itch.io/johns-quest"
        target="_blank"
        rel="noopener noreferrer"
        class="store-btn itch"
      >
        <Icon name="tabler:brand-itch" />
        itch.io
      </a>
      <a
        href="https://github.com/BenjaminHalko/John-Quest"
        target="_blank"
        rel="noopener noreferrer"
        class="store-btn github"
      >
        <Icon name="tabler:brand-github" />
        Source
      </a>
    </section>

    <section class="john">
      <Image
        src={footer}
        alt=""
        style="width: 100%"
        loading="eager"
        decoding="async"
        width={784}
        height={130}
      />
    </section>

    <section class="trailer">
      <h2>Trailer</h2>
      <YouTube
        id="cA0T3so10CQ"
        title="John's Quest Trailer"
        posterQuality="max"
      />
    </section>

    <section class="screenshots">
      <h2>Screenshots</h2>
      <div class="screenshot-grid">
        {
          gifs.map((gif) => (
            <Image src={gif.image} alt={gif.alt} loading="lazy" />
          ))
        }
      </div>
    </section>

    <section class="story">
      <h2>Story</h2>
      <p>
        Your shadow twin, <strong>Evil John</strong>, consumed by envy, has
        unleashed chaos across the realms. With his army of <strong
          >Evil Eyes</strong
        >, he has corrupted the land and caused genres to collide.
      </p>
      <p>Can you use your expertise in gaming to restore peace to the world?</p>
    </section>

    <section class="features">
      <h2>Features</h2>
      <ul>
        {
          features.map((feature) => (
            <li>
              <strong>{feature.title}</strong>
              <span>{feature.desc}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="details">
      <h2>Details</h2>
      <ul>
        <li><strong>Price</strong> <span>Free</span></li>
        <li><strong>Release Date</strong> <span>Feb 27, 2026</span></li>
        <li><strong>Developer</strong> <span>Benjamin Halko</span></li>
        <li><strong>Playtime</strong> <span>40 minutes</span></li>
        <li><strong>Stores</strong> <span>Steam, itch.io</span></li>
        <li><strong>Platforms</strong> <span>PC, MacOS, Linux</span></li>
        <li class="tags-item">
          <strong>Tags</strong>
          <div class="tags">
            {tags.map((tag) => <span class="chip">{tag}</span>)}
          </div>
        </li>
      </ul>
    </section>

    <section class="coverage">
      <h2>Reviews</h2>
      <div class="coverage-item">
        <strong>John Appleby</strong>
        <span class="coverage-quote">
          &ldquo;I don&rsquo;t think I&rsquo;ve ever been this happy to blow up my
          own face&rdquo;
        </span>
      </div>
      <a
        href="https://screenrant.com/steam-free-game-9-10-rpg-release-download/"
        target="_blank"
        rel="noopener noreferrer"
        class="coverage-item"
      >
        <strong>Screen Rant</strong>
        <span class="coverage-quote">
          &ldquo;A Remarkable 9/10 RPG Freebie&rdquo;
        </span>
        <span class="coverage-date">March 2026</span>
      </a>
    </section>

    <section class="presskit">
      <h2>Press Kit</h2>
      <p>
        <a
          href="/johnsquest/johns-quest-presskit.zip"
          download
          class="store-btn"
        >
          <Icon name="tabler:download" />
          Download Press Kit
        </a>
      </p>
    </section>

    <section class="contact">
      <h2>Contact</h2>
      <p>
        <a href="mailto:contact@benjaminhalko.dev" class="store-btn">
          <Icon name="tabler:mail" />
          contact@benjaminhalko.dev
        </a>
      </p>
    </section>
  </main>
</BaseLayout>
