---
import type {
  GetStaticPaths,
  ImageMetadata,
} from "astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import Button from "../components/Button.astro";
import Carousel from "../components/Carousel.astro";
import type { CarouselItem } from "../components/Carousel.astro";
import GameDescription from "../components/games/GameDescription.astro";
import JsonLd from "../components/JsonLd.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { games } from "../data/games";
import { SITE } from "../data/site";
import { generateGameSchema } from "../schema/game";
import "../styles/games.css";

const PLATFORM_ICON: Readonly<Record<string, string>> = {
  web: "tabler:world",
  windows: "tabler:brand-windows",
  android: "tabler:brand-android",
  macos: "tabler:brand-apple",
  linux: "tabler:brand-ubuntu",
  ios: "tabler:device-ipad",
};

export const getStaticPaths = (() => {
  const faviconModules = import.meta.glob<{ default: ImageMetadata }>(
    "../res/games/*/favicon.png",
    { eager: true },
  );
  const logoModules = import.meta.glob<{ default: ImageMetadata }>(
    "../res/games/*/logo.png",
    { eager: true },
  );
  const ogModules = import.meta.glob<{ default: ImageMetadata }>(
    "../res/games/*/og.png",
    { eager: true },
  );
  const faviconByGameId: Record<string, ImageMetadata> = Object.fromEntries(
    Object.entries(faviconModules).map(([path, module]) => [
      path.split("/").at(-2),
      module.default,
    ]),
  );
  const logoByGameId: Record<string, ImageMetadata> = Object.fromEntries(
    Object.entries(logoModules).map(([path, module]) => [
      path.split("/").at(-2),
      module.default,
    ]),
  );
  const ogByGameId: Record<string, ImageMetadata> = Object.fromEntries(
    Object.entries(ogModules).map(([path, module]) => [
      path.split("/").at(-2),
      module.default,
    ]),
  );

  const clipModules = import.meta.glob<string>(
    "../res/games/*/screenshots/clip*.mp4",
    { eager: true, query: "?url", import: "default" },
  );
  const posterModules = import.meta.glob<{ default: ImageMetadata }>(
    "../res/games/*/screenshots/clip*.poster.png",
    { eager: true },
  );
  const shotModules = import.meta.glob<{ default: ImageMetadata }>(
    "../res/games/*/screenshots/shot*.png",
    { eager: true },
  );
  const trailerThumbModules = import.meta.glob<{ default: ImageMetadata }>(
    "../res/games/*/screenshots/trailer.jpg",
    { eager: true },
  );
  const trailerThumbByGameId: Record<string, ImageMetadata> = Object.fromEntries(
    Object.entries(trailerThumbModules).map(([path, module]) => [
      path.split("/").at(-3),
      module.default,
    ]),
  );

  const entriesFor = <T,>(
    modules: Record<string, T>,
    gameId: string,
  ): [string, T][] =>
    Object.entries(modules)
      .filter(([path]) => path.split("/").at(-3) === gameId)
      .sort(([a], [b]) => a.localeCompare(b));

  const carouselItemsFor = (game: (typeof games)[number]): CarouselItem[] => {
    const trailerId = game.trailerYoutubeId;
    const trailerThumb = trailerThumbByGameId[game.id];
    const trailer: CarouselItem[] =
      trailerId !== undefined && trailerThumb !== undefined
        ? [
            {
              kind: "youtube",
              youtubeId: trailerId,
              title: `${game.name} Gameplay`,
              thumbnail: trailerThumb,
            },
          ]
        : [];

    const clips = entriesFor(clipModules, game.id).flatMap<CarouselItem>(
      ([path, src], index) => {
        const poster = posterModules[path.replace(/\.mp4$/, ".poster.png")];
        if (poster === undefined) return [];
        return [
          {
            kind: "video",
            src,
            poster: poster.default,
            label: `${game.name} gameplay ${index + 1}`,
          },
        ];
      },
    );

    const shots = entriesFor(shotModules, game.id).map<CarouselItem>(
      ([, module], index) => ({
        kind: "image",
        src: module.default,
        label: `${game.name} screenshot ${index + 1}`,
      }),
    );

    return [...trailer, ...clips, ...shots];
  };

  return games
    .filter(
      // Hammer Hex redirects to hammerhex.com via public/_redirects.
      (game) => game.id !== "hammerhex",
    )
    .map((game) => ({
      params: { game: game.id },
      props: {
        game,
        favicon: faviconByGameId[game.id],
        logo: logoByGameId[game.id],
        og: ogByGameId[game.id],
        carouselItems: carouselItemsFor(game),
      },
    }));
}) satisfies GetStaticPaths;

const { game, favicon, logo, og, carouselItems } = Astro.props;
const description = game.description || `Play ${game.name}`;
const pageUrl = `${SITE.hostname}/${game.id}`;
const ogImage = new URL(og.src, Astro.site).href;
---

<BaseLayout
  title={game.name}
  description={description}
  og={{
    url: pageUrl,
    title: game.name,
    description,
    image: ogImage,
  }}
  twitter={{
    card: "summary_large_image",
    url: pageUrl,
    title: game.name,
    description,
    image: ogImage,
  }}
>
  <Fragment slot="favicons">
    <link rel="icon" type="image/png" href={favicon.src} />
  </Fragment>
  <Fragment slot="head">
    <JsonLd data={generateGameSchema(game)} />
  </Fragment>
  <main class="content store-layout">
    <div class="store-main">
      <h1 style="margin: 0; padding: 0; display: flex;">
        <Image
          src={logo}
          alt={game.name}
          class="store-cover"
          loading="eager"
          fetchpriority="high"
        />
      </h1>
      <Carousel label={`${game.name} gameplay and screenshots`} items={carouselItems} />
      <div class="store-description">
        <GameDescription gameId={game.id} fallback={description} />
      </div>
    </div>

    <aside class="store-sidebar">
      <nav class="store-buttons" aria-label="Game Store Links">
        {
          game.itchio && (
            <Button
              link={game.itchio}
              color="#FA5C5C"
              text="Itch.io"
              icon="tabler:brand-itch"
            />
          )
        }
        {
          game.googleplay && (
            <Button
              link={game.googleplay}
              color="lime"
              text="Google Play"
              icon="tabler:brand-google-play"
            />
          )
        }
        {
          game.gxgames && (
            <Button
              link={game.gxgames}
              color="#fc1d4e"
              text="GX Games"
              icon="tabler:brand-opera"
            />
          )
        }
        {
          game.github && (
            <Button
              link={game.github}
              color="cyan"
              text="GitHub"
              icon="tabler:brand-github"
            />
          )
        }
      </nav>

      <div class="store-metadata">
        <div class="meta-row">
          <span class="meta-label">Developer</span>
          <span class="meta-value">Benjamin Halko</span>
        </div>
        {
          game.genre && (
            <div class="meta-row">
              <span class="meta-label">Genre</span>
              <span class="meta-value">{game.genre}</span>
            </div>
          )
        }
        {
          game.jamEventName && game.jamEventUrl && (
            <div class="meta-row">
              <span class="meta-label">Jam</span>
              <a
                class="meta-value meta-link"
                href={game.jamEventUrl}
                target="_blank"
                rel="nofollow noopener noreferrer"
              >
                {game.jamEventName}
              </a>
            </div>
          )
        }
        {
          game.platforms && game.platforms.length > 0 && (
            <div class="meta-row">
              <span class="meta-label">Platform</span>
              <span class="meta-value platform-icons">
                {game.platforms.map((platform) => (
                  <span
                    class="platform-icon"
                    title={platform}
                    aria-label={platform}
                    role="img"
                  >
                    <Icon name={PLATFORM_ICON[platform]} />
                  </span>
                ))}
              </span>
            </div>
          )
        }
      </div>

      <footer class="game-footer-links">
        <Button
          link={`/${game.id}/privacypolicy`}
          color="grey"
          text="Privacy Policy"
          icon="tabler:shield-lock"
          style="padding: 8px 16px; font-size: 0.9rem;"
          newTab={false}
        />
      </footer>
    </aside>
  </main>
</BaseLayout>
