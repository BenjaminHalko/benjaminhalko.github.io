---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import avatar from "../res/avatar.png";
import { games } from "../data/games";
import { SITE, SOCIALS } from "../data/site";

const navSocials = SOCIALS.slice(0, 4);
const faviconModules = import.meta.glob<{ default: ImageMetadata }>(
  "../res/games/*/favicon.png",
  { eager: true },
);
const faviconByGameId: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(faviconModules).map(([path, module]) => [
    path.split("/").at(-2),
    module.default,
  ]),
);

const hammerHexFavicon = faviconByGameId.hammerhex;
const unlessFavicon = faviconByGameId.unless;
const jamGames = games.filter((game) => game.isJamGame);
---

<nav class="navbar" transition:persist="navbar">
  <div class="navbar-left">
    <a href="/">
      <Image
        src={avatar}
        alt={SITE.author}
        width={24}
        densities={[1, 2]}
        class="nav-avatar"
        loading="eager"
        decoding="async"
      />
      <span>{SITE.author}</span>
    </a>
  </div>
  <div class="navbar-center">
    <a href="/johnsquest">John's Quest</a>
    <div class="nav-dropdown">
      <button
        type="button"
        class="nav-dropdown-trigger"
        popovertarget="nav-games-menu"
      >
        Games <Icon name="tabler:chevron-down" class="nav-dropdown-caret" />
      </button>
      <div class="nav-dropdown-content" id="nav-games-menu" popover>
        <span class="nav-dropdown-label">Releases</span>
        <a href="/johnsquest">
          <Image src={faviconByGameId.johnsquest} alt="" loading="eager" /> John's Quest
        </a>
        <a href="https://hammerhex.com">
          <Image src={hammerHexFavicon} alt="" loading="eager" /> Hammer Hex
        </a>
        <a href="https://store.steampowered.com/app/2944340/Unless/">
          <Image src={unlessFavicon} alt="" loading="eager" /> Unless
        </a>
        <hr class="nav-divider" />
        <span class="nav-dropdown-label">Jam Games</span>
        {
          jamGames.map((game) => (
            <a href={`/${game.id}`}>
              <Image src={faviconByGameId[game.id]} alt="" loading="eager" /> {game.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="navbar-right">
    {
      navSocials.map((social) => (
        <a
          href={social.link}
          class="nav-social"
          style={`--col: ${social.color}`}
          aria-label={social.text}
        >
          <Icon name={social.icon} />
        </a>
      ))
    }
  </div>
</nav>

<script>
  const TOLERANCE = 120;
  const GRACE_DELAY = 150;
  const GAP = 10;
  const EDGE = 12;

  function setupDropdown(): () => void {
    const wrapper = document.querySelector(".nav-dropdown");
    const trigger = document.querySelector(".nav-dropdown-trigger");
    const menu = document.getElementById("nav-games-menu");
    if (
      !(wrapper instanceof HTMLElement) ||
      !(trigger instanceof HTMLElement) ||
      !(menu instanceof HTMLElement)
    ) {
      return () => {};
    }

    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    /* Measured on the wrapper, not the button: the button scales to 1.05 while
       open, which would drag the menu with it. The CSS translate(-50%) does the
       centring, so `half` is 0 until the menu has been laid out — which lets the
       first call run on `beforetoggle`, before the popover ever paints. */
    const place = (half: number): void => {
      const rect = wrapper.getBoundingClientRect();
      const centre = rect.left + rect.width / 2;
      const min = EDGE + half;
      const max = window.innerWidth - EDGE - half;
      menu.style.left = `${Math.max(min, Math.min(centre, max))}px`;
      menu.style.top = `${rect.bottom + GAP}px`;
    };

    const placeClamped = (): void => {
      place(menu.getBoundingClientRect().width / 2);
    };

    const isOpening = (event: Event): boolean =>
      event instanceof ToggleEvent && event.newState === "open";

    const onBeforeToggle = (event: Event): void => {
      if (isOpening(event)) place(0);
    };

    const onToggle = (event: Event): void => {
      if (isOpening(event)) placeClamped();
    };

    const onReflow = (): void => {
      if (menu.matches(":popover-open")) placeClamped();
    };

    const cancelClose = (): void => {
      if (closeTimer !== null) clearTimeout(closeTimer);
      closeTimer = null;
    };

    const close = (): void => {
      cancelClose();
      if (menu.matches(":popover-open")) menu.hidePopover();
    };

    const onPointerMove = (event: PointerEvent): void => {
      if (!menu.matches(":popover-open")) {
        cancelClose();
        return;
      }

      const a = trigger.getBoundingClientRect();
      const b = menu.getBoundingClientRect();
      const dx = Math.max(
        Math.min(a.left, b.left) - event.clientX,
        0,
        event.clientX - Math.max(a.right, b.right),
      );
      const dy = Math.max(
        Math.min(a.top, b.top) - event.clientY,
        0,
        event.clientY - Math.max(a.bottom, b.bottom),
      );

      if (Math.hypot(dx, dy) > TOLERANCE) {
        if (closeTimer === null) closeTimer = setTimeout(close, GRACE_DELAY);
      } else {
        cancelClose();
      }
    };

    menu.addEventListener("beforetoggle", onBeforeToggle);
    menu.addEventListener("toggle", onToggle);
    window.addEventListener("scroll", onReflow, { capture: true, passive: true });
    window.addEventListener("resize", onReflow, { passive: true });
    document.addEventListener("pointermove", onPointerMove, { passive: true });

    return () => {
      cancelClose();
      menu.removeEventListener("beforetoggle", onBeforeToggle);
      menu.removeEventListener("toggle", onToggle);
      window.removeEventListener("scroll", onReflow, { capture: true });
      window.removeEventListener("resize", onReflow);
      document.removeEventListener("pointermove", onPointerMove);
    };
  }

  let cleanup: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = setupDropdown();
  });

  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>


