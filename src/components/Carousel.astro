---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";
import { YouTube } from "astro-embed";
import { Icon } from "astro-icon/components";
import "../styles/carousel.css";

export type CarouselItem =
  | {
      kind: "youtube";
      youtubeId: string;
      title: string;
      thumbnail: ImageMetadata;
    }
  | { kind: "video"; src: string; poster: ImageMetadata; label: string }
  | { kind: "image"; src: ImageMetadata; label: string };

export interface Props {
  label: string;
  items: readonly CarouselItem[];
}

const { label, items } = Astro.props;

const describe = (item: CarouselItem): string =>
  item.kind === "youtube" ? item.title : item.label;

const thumbnailOf = (item: CarouselItem): ImageMetadata => {
  if (item.kind === "youtube") return item.thumbnail;
  if (item.kind === "video") return item.poster;
  return item.src;
};

const posterUrls = new Map<string, string>();
for (const item of items) {
  if (item.kind !== "video") continue;
  const poster = await getImage({
    src: item.poster,
    format: "webp",
    width: 1280,
  });
  posterUrls.set(item.src, poster.src);
}
---

{
  items.length > 0 && (
    <section
      class="carousel"
      data-carousel
      aria-roledescription="carousel"
      aria-label={label}
    >
      <div class="carousel-stage">
        <ul class="carousel-track" data-carousel-track tabindex="0">
          {items.map((item, index) => (
            <li
              class="carousel-slide"
              data-carousel-slide
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${items.length}: ${describe(item)}`}
            >
              {item.kind === "youtube" && (
                <YouTube
                  id={item.youtubeId}
                  title={item.title}
                  posterQuality="max"
                />
              )}
              {item.kind === "video" && (
                <video
                  data-carousel-video
                  src={item.src}
                  poster={posterUrls.get(item.src)}
                  aria-label={item.label}
                  muted
                  loop
                  playsinline
                  preload="none"
                />
              )}
              {item.kind === "image" && (
                <Image
                  src={item.src}
                  alt={item.label}
                  widths={[480, 800, 1280]}
                  sizes="(max-width: 800px) 100vw, 640px"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              )}
            </li>
          ))}
        </ul>
      </div>

      {items.length > 1 && (
        <div class="carousel-filmstrip">
          <button
            type="button"
            class="carousel-arrow"
            data-carousel-prev
            aria-label="Previous slide"
          >
            <Icon name="tabler:chevron-left" />
          </button>

          <ul class="carousel-thumbs" data-carousel-thumbs>
            {items.map((item, index) => (
              <li>
                <button
                  type="button"
                  class="carousel-thumb"
                  data-carousel-thumb
                  tabindex={index === 0 ? 0 : -1}
                  aria-label={`Show slide ${index + 1}: ${describe(item)}`}
                >
                  <Image
                    src={thumbnailOf(item)}
                    alt=""
                    widths={[160, 320]}
                    sizes="160px"
                    loading="eager"
                    fetchpriority="low"
                    decoding="async"
                  />
                  {item.kind !== "image" && (
                    <span class="carousel-thumb-badge">
                      <Icon name="tabler:player-play-filled" />
                    </span>
                  )}
                </button>
              </li>
            ))}
          </ul>

          <button
            type="button"
            class="carousel-arrow"
            data-carousel-next
            aria-label="Next slide"
          >
            <Icon name="tabler:chevron-right" />
          </button>
        </div>
      )}
    </section>
  )
}

<script>
  function setupCarousel(root: HTMLElement): void {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    if (track === null) return;

    const slides = Array.from(
      track.querySelectorAll<HTMLElement>("[data-carousel-slide]"),
    );
    if (slides.length === 0) return;

    const thumbs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-carousel-thumb]"),
    );
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const videos = Array.from(
      root.querySelectorAll<HTMLVideoElement>("[data-carousel-video]"),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let current = 0;

    if (reducedMotion.matches) {
      for (const video of videos) {
        video.autoplay = false;
        video.controls = true;
        video.pause();
      }
    }

    const setCurrent = (index: number): void => {
      current = index;
      thumbs.forEach((thumb, thumbIndex) => {
        const isCurrent = thumbIndex === index;
        if (isCurrent) thumb.setAttribute("aria-current", "true");
        else thumb.removeAttribute("aria-current");
        thumb.tabIndex = isCurrent ? 0 : -1;
      });
      thumbs[index]?.scrollIntoView({ block: "nearest", inline: "nearest" });
    };

    const goTo = (index: number): void => {
      const count = slides.length;
      const target = slides[((index % count) + count) % count];
      if (target === undefined) return;
      track.scrollTo({
        left: target.offsetLeft - track.offsetLeft,
        behavior: reducedMotion.matches ? "auto" : "smooth",
      });
    };

    prev?.addEventListener("click", () => goTo(current - 1));
    next?.addEventListener("click", () => goTo(current + 1));
    thumbs.forEach((thumb, index) => {
      thumb.addEventListener("click", () => goTo(index));
    });

    const thumbList = root.querySelector<HTMLElement>("[data-carousel-thumbs]");
    thumbList?.addEventListener("keydown", (event) => {
      const targets: Record<string, number> = {
        ArrowRight: current + 1,
        ArrowLeft: current - 1,
        Home: 0,
        End: slides.length - 1,
      };
      const target = targets[event.key];
      if (target === undefined) return;
      event.preventDefault();
      const count = slides.length;
      const index = ((target % count) + count) % count;
      goTo(index);
      thumbs[index]?.focus();
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const slide = entry.target;
          if (!(slide instanceof HTMLElement)) continue;
          const video = slide.querySelector<HTMLVideoElement>("video");

          if (entry.isIntersecting) {
            setCurrent(slides.indexOf(slide));
            if (video !== null && !reducedMotion.matches) {
              video.preload = "auto";
              void video.play().catch(() => {
                video.controls = true;
              });
            }
          } else if (video !== null) {
            video.pause();
          }
        }
      },
      { root: track, threshold: 0.6 },
    );
    for (const slide of slides) observer.observe(slide);

    setCurrent(0);
    root.dataset.carouselReady = "";
  }

  function setupAllCarousels(): void {
    const roots = document.querySelectorAll<HTMLElement>("[data-carousel]");
    for (const root of roots) {
      if (root.dataset.carouselReady === undefined) setupCarousel(root);
    }
  }

  document.addEventListener("astro:page-load", setupAllCarousels);
</script>
