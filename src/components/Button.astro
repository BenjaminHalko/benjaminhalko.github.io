---
import { Icon } from "astro-icon/components";

export interface Props {
  link: string;
  color: string;
  text: string;
  icon: string;
  style?: string;
  newTab?: boolean;
}

const { link, color, text, icon, style = "", newTab = true } = Astro.props;
---

<a
  class="button"
  href={link}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  style={`--col: ${color};${style}`}
>
  <Icon name={icon} />
  <span>{text}</span>
</a>
