---
import { ClientRouter, fade } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import "../styles/main.css";

interface OpenGraph {
  readonly url: string;
  readonly title: string;
  readonly description: string;
  readonly image: string;
  readonly card: string;
}

export interface Props {
  readonly title: string;
  readonly description?: string;
  readonly robots?: string;
  readonly og: OpenGraph;
}

const { title, description, robots, og } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate={fade({ duration: "320ms" })}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <slot name="favicons" />
    <meta name="robots" content={robots ?? "max-image-preview:large"} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={og.url} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:image" content={og.image} />
    <meta name="twitter:card" content={og.card} />
    <meta name="twitter:url" content={og.url} />
    <meta name="twitter:title" content={og.title} />
    <meta name="twitter:description" content={og.description} />
    <meta name="twitter:image" content={og.image} />
    <slot name="head" />
  </head>
  <body>
    <Navbar />
    <slot />
    <script>
      interface BeforeSwapEvent extends Event {
        readonly newDocument: Document;
      }

      document.addEventListener("astro:before-swap", (event) => {
        const e = event as BeforeSwapEvent;
        e.newDocument.documentElement.dataset.navSettled = "";
        const menu = document.getElementById("nav-games-menu");
        if (menu instanceof HTMLElement && menu.matches(":popover-open")) {
          menu.hidePopover();
        }
      });
    </script>
  </body>
</html>
