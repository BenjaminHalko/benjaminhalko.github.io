# Cloudflare Workers Assets defaults every response to
# `public, max-age=0, must-revalidate`, which forces a conditional request per
# asset on every navigation. Everything Astro emits under /assets/ carries a
# content hash in its filename (including assets/fonts/*.woff2), so it can
# never change identity and is safe to cache forever.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/johnsquest/*
  Cache-Control: public, max-age=86400

# Unhashed, so they need a TTL short enough to allow replacing them.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/android-chrome-192x192.png
  Cache-Control: public, max-age=86400
/android-chrome-512x512.png
  Cache-Control: public, max-age=86400
/mstile-150x150.png
  Cache-Control: public, max-age=86400
/safari-pinned-tab.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
/browserconfig.xml
  Cache-Control: public, max-age=86400
